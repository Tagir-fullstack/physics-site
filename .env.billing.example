# Server only. Never prefix secrets with VITE_. No real charges by default.
BILLING_MODE=disabled
BILLING_STORAGE_READY=false
EPAY_PUBLIC_ORIGIN=https://physez.com
EPAY_TEST_TERMINAL_ID=
EPAY_TEST_CLIENT_ID=
EPAY_TEST_CLIENT_SECRET=
EPAY_TEST_MONTH_PRICE_KZT=
EPAY_TEST_YEAR_PRICE_KZT=
EPAY_LIVE_TERMINAL_ID=
EPAY_LIVE_CLIENT_ID=
EPAY_LIVE_CLIENT_SECRET=
EPAY_LIVE_MONTH_PRICE_KZT=
EPAY_LIVE_YEAR_PRICE_KZT=
# Independent randomly generated values, store in the server secret manager.
# CARD_KEY: 32 random bytes encoded as 64 hex characters; CALLBACK/JOB: >=32 chars.
BILLING_CARD_KEY=
BILLING_CALLBACK_KEY=
BILLING_SCHEDULER_SECRET=
BILLING_RECURRING_ENABLED=false
# All require explicit owner approval; legal registry must also be complete.
BILLING_LIVE_APPROVED=false
BILLING_HOSTING_APPROVED=false
BILLING_LEGAL_APPROVED=false
BILLING_FISCAL_APPROVED=false
BILLING_RECURRING_APPROVED=false
